# --- data & generated artefacts (never commit large/derived files) ---
data/yolo/              # YOLO dataset built by prepare_dataset.py
data/received/*.mp4     # source video is large; reviewer adds it locally
outputs/                # training runs, weights (best.pt)
runs/                   # Ultralytics default run dir (fallback)
mlruns/                 # MLflow experiment history
prediction.csv          # generated predictions
/part1.csv              # generated predictions at repo ROOT only (keeps data/received/part1.csv)
analysis/figures/       # EDA figures are regenerated by explore_dataset.py
.claude
CLAUDE.md

